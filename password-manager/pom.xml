<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.mox1st</groupId>
  <artifactId>password-manager</artifactId>
  <version>1.0-SNAPSHOT</version>   <!--Die aktuelle version, Das projekt befindet sich noch in der Entwicklung-->

  <name>password-manager</name>
  <!-- FIXME change it to the project's website -->
  <url>http://www.example.com</url> <!--Änderung vornehmen!-->

  <properties>    <!--Hier speichern wir allgemeine Einstellungen.-->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding> <!--Legt die Zeichenkodierung des Projekts auf UTF-8 fest.-->
    <maven.compiler.release>26</maven.compiler.release> 
    <javafx.version>26.0.1</javafx.version> 
  </properties>

  <dependencies>                    <!--Hier stehen später Bibliotheken wie:JavaFX, SQLite,...-->
    <dependency> 
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>  <!--Enthält: Button, Label, TextField, PasswordField, TableView, ListView, MenuBar.-->
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId> <!--Ermöglicht das Laden von .fxml-Dateien. Dadurch trennen wir später: Design(FXML), Logik(Java)-->
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>      <!--Der Hersteller-->
      <artifactId>junit</artifactId> <!--Die Bibliothek-->
      <version>4.11</version>
      <scope>test</scope>           <!--Diese Bibliothek wird nur zum Testen verwendet. Sie gehört später nicht zum fertigen Programm-->
    </dependency>
  </dependencies>

  <build>                            <!--Hier wird festgelegt, wie Maven das Projekt baut.-->
      <plugins>        <!--Ein Plugin erweitert Maven um zusätzliche Funktionen.-->
        <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>0.0.8</version>

          <configuration>
              <mainClass>de.mox1st.passwordmanager.app.Main</mainClass>
            </configuration>
          </plugin>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId> <!--löscht den target/ Ordner. Dadurch entsteht ein sauberer Build-->
          <version>3.1.0</version>
        </plugin>
        <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->
        <plugin>
          <artifactId>maven-resources-plugin</artifactId> <!--Kopiert Dateien aus resources in das fertige Programm.-->
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId> <!--Übersetzt : .java in .class-->
          <version>3.15.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId> <!--Startet automatisch alle Tests-->
          <version>2.22.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId> <!--Erstellt später password-manager.jar-->
          <version>3.0.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId> <!--Installiert das Projekt lokal. Andere Projekte können es dann benutzen.-->
          <version>2.5.2</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId> <!--Lädt das Projekt auf einen Maven-Server hoch.-->
          <version>2.8.2</version>
        </plugin>
        <!-- site lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#site_Lifecycle -->
        <plugin>
          <artifactId>maven-site-plugin</artifactId> <!--Erstellt automatisch eine Projekt-Website.-->
          <version>3.7.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-project-info-reports-plugin</artifactId> <!--Erstellt Berichte.-->
          <version>3.0.0</version>
        </plugin>
      </plugins>
  </build>
</project>
